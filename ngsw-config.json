{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.svg", "/*.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "icons",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**"]
      }
    },
    {
      "name": "hand-tracking-runtime",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/mediapipe/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "hand-tracking-model",
      "urls": ["https://storage.googleapis.com/mediapipe-models/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 2,
        "maxAge": "30d"
      }
    }
  ]
}
